<resources>
    <style name="LongshotTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/action</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowSplashScreenBackground">@color/page</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/longshot</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <bool name="light_bars">true</bool>
    <style name="Detail">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="CardAction" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#CBC4FF</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:background">@drawable/toolbar_secondary</item>
        <item name="android:backgroundTint">@null</item>
    </style>
</resources>
