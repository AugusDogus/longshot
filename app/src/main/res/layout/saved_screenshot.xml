<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp">

    <ImageButton android:id="@+id/preview" android:layout_width="56dp" android:layout_height="72dp"
        android:background="@drawable/toolbar_secondary" android:foreground="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter" android:padding="4dp" android:src="@drawable/ic_capture"
        android:contentDescription="@string/open_screenshot" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/screenshot_saved"
            android:textSize="14sp" android:textColor="#F6F2FF" android:fontFamily="sans-serif-medium" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/edit" style="@style/CardAction" android:text="@string/edit_screenshot"
                android:drawableStart="@drawable/ic_edit" />
            <Button android:id="@+id/share" style="@style/CardAction" android:text="@string/share_screenshot"
                android:drawableStart="@drawable/ic_share" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton android:id="@+id/close" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/toolbar_secondary" android:src="@drawable/ic_close"
        android:tint="#D1CDDD" android:contentDescription="@string/dismiss_preview" />
</LinearLayout>
